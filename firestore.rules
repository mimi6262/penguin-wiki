rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 편집자 명단(editors/{uid})에 있으면 가이드, role == 'admin' 이면 운영자
    function signedIn() { return request.auth != null; }
    function editorDoc() { return get(/databases/$(database)/documents/editors/$(request.auth.uid)); }
    function isEditor() { return signedIn() && exists(/databases/$(database)/documents/editors/$(request.auth.uid)); }
    function isAdmin() { return isEditor() && editorDoc().data.role == 'admin'; }
    // 비었거나(null) n자 이하 글자
    function optStr(v, n) { return v == null || (v is string && v.size() <= n); }

    // 가이드 문서: 공개 문서는 누구나, 비공개·임시본은 편집자만
    match /pages/{slug} {
      allow read: if resource.data.public == true || isEditor();
      allow create, update, delete: if isEditor();
    }
    match /pageVersions/{id} {
      allow read, create: if isEditor();
      allow update, delete: if false;
    }
    // 임시저장 원고: 편집자만. 공개 문서는 pages 문서 전체가 공개라 게시 전 원고는 여기에 따로 둔다
    match /pageDrafts/{slug} {
      allow read, write: if isEditor();
    }
    match /sections/{id} {
      allow read: if true;
      allow write: if isEditor();
    }

    // 사이트 설정(홈 화면 값, 푸터)
    match /settings/{id} {
      allow read: if id != 'private';   // settings/private(디스코드 웹훅 등 비밀값)은 아래에서 편집자만
      allow write: if isEditor();
    }
    match /settings/private {
      allow read, write: if isEditor();
    }

    // 2차: 이벤트 · 패치노트 · 카테고리 · 명령어 · 팝업 설정 (공개 읽기, 편집자 쓰기)
    match /events/{id} { allow read: if true; allow write: if isEditor(); }
    match /patchNotes/{id} { allow read: if resource.data.status == 'published' || isEditor(); allow write: if isEditor(); }
    match /patchCategories/{id} { allow read: if true; allow write: if isEditor(); }
    match /commands/{id} { allow read: if true; allow write: if isEditor(); }
    match /popups/{id} { allow read: if true; allow write: if isEditor(); }

    // 3차: 시세 — 읽기 공개, 쓰기는 편집자(운영자 스크립트는 서비스 계정으로 규칙을 우회)
    match /prices/{id} { allow read: if true; allow write: if isEditor(); }

    // 문서 이미지: 편집기에서 올린 그림(압축된 data URL, 1MB 미만). 읽기 공개, 편집자만 올리고 지움
    match /images/{id} {
      allow read: if true;
      allow create: if isEditor() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if isEditor();
      allow update: if false;
    }

    // 편집자 명단: 편집자는 읽기, 운영자만 쓰기
    match /editors/{uid} {
      allow read: if isEditor();
      allow write: if isAdmin();
    }
    // 명단 등록 요청: 로그인은 되지만 명단에 없는 계정이 본인 UID 로 남김. 운영자가 보고 승인/삭제
    // 이메일은 실제 로그인한 계정의 이메일과 같아야 함(다른 사람 이메일로 꾸민 요청 차단), 칸은 email · at 만
    match /editorRequests/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'at'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
    }

    // 접속 이력: 편집자가 로그인할 때 본인 기록만. 정해진 칸 · 길이만, 가이드는 운영자로 적을 수 없음. 운영자만 조회
    match /loginLogs/{id} {
      allow create: if isEditor()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'role', 'at', 'ua'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && (request.resource.data.role == 'guide' || (request.resource.data.role == 'admin' && isAdmin()))
        && optStr(request.resource.data.get('name', null), 100)
        && optStr(request.resource.data.get('email', null), 200)
        && optStr(request.resource.data.get('ua', null), 300);
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    // 조회수(assets/js/views.js): 누구나 "1 올리기"만. 칸은 total(전체) · days(날짜별, 'YYYY-MM-DD') · d(이번에 올린 날짜)뿐,
    // 한 번에 total 과 days[d] 를 정확히 1씩. 새로 만들 땐 주요 페이지 키이거나 있는 문서만. 누가 봤는지는 남기지 않음. 편집자만 조회
    function isDay(v) { return v is string && v.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$'); }
    match /views/{key} {
      allow read: if isEditor();
      allow create: if (key in ['_home', '_patch', '_events', '_commands', '_prices'] || exists(/databases/$(database)/documents/pages/$(key)))
        && request.resource.data.keys().hasOnly(['total', 'days', 'd'])
        && isDay(request.resource.data.d)
        && request.resource.data.total == 1
        && request.resource.data.days.keys().hasOnly([request.resource.data.d])
        && request.resource.data.days[request.resource.data.d] == 1;
      allow update: if request.resource.data.keys().hasOnly(['total', 'days', 'd'])
        && isDay(request.resource.data.d)
        && request.resource.data.total == resource.data.total + 1
        && request.resource.data.days.diff(resource.data.days).affectedKeys().hasOnly([request.resource.data.d])
        && request.resource.data.days[request.resource.data.d] == resource.data.days.get(request.resource.data.d, 0) + 1;
      allow delete: if isAdmin();
    }

    // 수정 이력: 편집자 생성·조회, 수정·삭제 불가
    match /editLogs/{id} {
      allow create, read: if isEditor();
      allow update, delete: if false;
    }
  }
}
